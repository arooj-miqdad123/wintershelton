@model WinterSheltonHouse.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}
<div class="page-header">
    <div class="container"><h1><i class="fas fa-user-circle"></i> My Profile</h1></div>
</div>
<div class="container" style="max-width:600px;margin-bottom:60px">
    <div style="background:white;border-radius:12px;box-shadow:0 4px 20px rgba(13,27,42,.12);padding:32px">
        <div style="display:flex;align-items:center;gap:20px;margin-bottom:28px">
            <div style="width:72px;height:72px;border-radius:50%;background:#0d1b2a;display:flex;align-items:center;justify-content:center;color:white;font-size:28px">
                <i class="fas fa-user"></i>
            </div>
            <div>
                <h2 style="font-family:'Playfair Display',serif;font-size:22px;color:#0d1b2a">@Model?.FullName</h2>
                <p style="color:#6b7280;font-size:14px">@Model?.Email</p>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
            <div style="padding:16px;background:#f8fafc;border-radius:8px">
                <div style="font-size:11px;color:#9bb8cc;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Full Name</div>
                <div style="font-weight:600">@Model?.FullName</div>
            </div>
            <div style="padding:16px;background:#f8fafc;border-radius:8px">
                <div style="font-size:11px;color:#9bb8cc;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Email</div>
                <div style="font-weight:600">@Model?.Email</div>
            </div>
            <div style="padding:16px;background:#f8fafc;border-radius:8px">
                <div style="font-size:11px;color:#9bb8cc;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">City</div>
                <div style="font-weight:600">@(string.IsNullOrEmpty(Model?.City) ? "Not set" : Model.City)</div>
            </div>
            <div style="padding:16px;background:#f8fafc;border-radius:8px">
                <div style="font-size:11px;color:#9bb8cc;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Member Since</div>
                <div style="font-weight:600">@Model?.CreatedAt.ToString("MMM yyyy")</div>
            </div>
        </div>
        <div style="margin-top:24px;display:flex;gap:12px">
            <a href="/Checkout/MyOrders" class="btn-primary"><i class="fas fa-box"></i> My Orders</a>
        </div>
    </div>
</div>
