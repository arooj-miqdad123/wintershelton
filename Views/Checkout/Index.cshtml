@model WinterSheltonHouse.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-lock"></i> Checkout</h1>
    </div>
</div>

<div class="container">
    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        <div asp-validation-summary="All" class="validation-error"></div>
        @Html.AntiForgeryToken()

        <div class="checkout-layout">
            <!-- Left: Form -->
            <div class="checkout-form">
                <!-- Shipping Info -->
                <div class="checkout-section">
                    <h3><i class="fas fa-map-marker-alt"></i> Delivery Information</h3>
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label>Full Name *</label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter your name" />
                            <span asp-validation-for="FullName" class="field-error"></span>
                        </div>
                        <div class="form-group">
                            <label>Phone Number *</label>
                            <input asp-for="Phone" class="form-control" placeholder="0300-1234567" />
                            <span asp-validation-for="Phone" class="field-error"></span>
                        </div>
                        <div class="form-group">
                            <label>City *</label>
                            <input asp-for="City" class="form-control" placeholder="Lahore, Karachi..." />
                            <span asp-validation-for="City" class="field-error"></span>
                        </div>
                        <div class="form-group full-width">
                            <label>Full Address *</label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter house/street/area"></textarea>
                            <span asp-validation-for="Address" class="field-error"></span>
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="checkout-section">
                    <h3><i class="fas fa-credit-card"></i> Payment Method</h3>
                    <div class="payment-options">
                        <label class="payment-option active" id="cod-option">
                            <input type="radio" asp-for="PaymentMethod" value="CashOnDelivery" checked id="codRadio" onchange="togglePayment('cod')" />
                            <div class="payment-icon-wrap cod">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                            <div class="payment-info">
                                <strong>Cash on Delivery (COD)</strong>
                                <span>Pay cash upon delivery</span>
                            </div>
                            <i class="fas fa-check-circle check-icon"></i>
                        </label>

                        <label class="payment-option" id="card-option">
                            <input type="radio" asp-for="PaymentMethod" value="CreditCard" id="cardRadio" onchange="togglePayment('card')" />
                            <div class="payment-icon-wrap card">
                                <i class="fas fa-credit-card"></i>
                            </div>
                            <div class="payment-info">
                                <strong>Credit / Debit Card</strong>
                                <span>Visa, Mastercard, etc.</span>
                            </div>
                            <i class="fas fa-check-circle check-icon"></i>
                        </label>
                    </div>

                    <!-- Card Details -->
                    <div id="cardDetails" class="card-details" style="display:none">
                        <div class="card-preview">
                            <div class="fake-card">
                                <div class="card-chip"><i class="fas fa-microchip"></i></div>
                                <div class="card-number-display" id="cardDisplay">**** **** **** ****</div>
                                <div class="card-bottom">
                                    <div>
                                        <div class="card-label">Card Holder</div>
                                        <div id="holderDisplay">YOUR NAME</div>
                                    </div>
                                    <div>
                                        <div class="card-label">Expires</div>
                                        <div id="expiryDisplay">MM/YY</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Card Number</label>
                            <input asp-for="CardNumber" class="form-control card-input" placeholder="1234 5678 9012 3456"
                                   maxlength="19" oninput="formatCard(this)" />
                            <span class="card-hint"><i class="fas fa-info-circle"></i> Enter any 16-digit number (for testing)</span>
                        </div>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Card Holder Name</label>
                                <input asp-for="CardHolder" class="form-control" placeholder="YOUR NAME"
                                       oninput="document.getElementById('holderDisplay').textContent = this.value || 'YOUR NAME'" />
                            </div>
                            <div class="form-group">
                                <label>Expiry Date</label>
                                <input asp-for="ExpiryDate" class="form-control" placeholder="MM/YY" maxlength="5"
                                       oninput="formatExpiry(this); document.getElementById('expiryDisplay').textContent = this.value || 'MM/YY'" />
                            </div>
                            <div class="form-group">
                                <label>CVV</label>
                                <input asp-for="CVV" class="form-control" placeholder="123" maxlength="4"
                                       type="password" />
                            </div>
                        </div>
                        <div class="test-card-info">
                            <i class="fas fa-lightbulb"></i>
                            <strong>Test Card Details:</strong>
                            Card: 4111 1111 1111 1111 | Expiry: 12/28 | CVV: 123 | Name: TEST USER
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <div class="order-summary">
                <div class="summary-card sticky-summary">
                    <h3><i class="fas fa-receipt"></i> Order Summary</h3>
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="summary-item">
                            <img src="@item.ImageUrl" alt="@item.ProductName" onerror="this.src='/images/placeholder.jpg'" />
                            <div class="summary-item-info">
                                <span class="item-name">@item.ProductName</span>
                                <span class="item-qty">x@item.Quantity</span>
                            </div>
                            <span class="item-total">Rs. @item.Total.ToString("N0")</span>
                        </div>
                    }
                    <div class="summary-divider"></div>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>Rs. @Model.Total.ToString("N0")</span>
                    </div>
                    <div class="summary-row">
                        <span>Delivery</span>
                        <span>@(Model.Total >= 5000 ? "Free" : "Rs. 200")</span>
                    </div>
                    <div class="summary-total grand">
                        <span>Grand Total</span>
                        <span>Rs. @((Model.Total + (Model.Total >= 5000 ? 0 : 200)).ToString("N0"))</span>
                    </div>
                    <button type="submit" class="btn-place-order">
                        <i class="fas fa-check-circle"></i> Place Order
                    </button>
                    <a href="/Cart" class="btn-back-cart">
                        <i class="fas fa-arrow-left"></i> Back to Cart
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
function togglePayment(type) {
    const codOpt = document.getElementById('cod-option');
    const cardOpt = document.getElementById('card-option');
    const cardDetails = document.getElementById('cardDetails');

    if (type === 'card') {
        cardOpt.classList.add('active');
        codOpt.classList.remove('active');
        cardDetails.style.display = 'block';
    } else {
        codOpt.classList.add('active');
        cardOpt.classList.remove('active');
        cardDetails.style.display = 'none';
    }
}

function formatCard(input) {
    let val = input.value.replace(/\D/g, '').substring(0, 16);
    let formatted = val.match(/.{1,4}/g)?.join(' ') || val;
    input.value = formatted;
    let display = formatted.padEnd(19, ' ');
    document.getElementById('cardDisplay').textContent = formatted || '**** **** **** ****';
}

function formatExpiry(input) {
    let val = input.value.replace(/\D/g, '').substring(0, 4);
    if (val.length >= 2) val = val.substring(0, 2) + '/' + val.substring(2);
    input.value = val;
}
</script>
}
