@model List<WinterSheltonHouse.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-shopping-bag"></i> My Cart</h1>
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-shopping-bag"></i>
            <h3>Your cart is empty</h3>
            <p>Add some products and start shopping!</p>
            <a href="/Home/Products" class="btn-primary">Browse Products</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                <div class="cart-header">
                    <span>Product</span>
                    <span>Price</span>
                    <span>Quantity</span>
                    <span>Total</span>
                    <span></span>
                </div>
                @foreach (var item in Model)
                {
                    <div class="cart-row">
                        <div class="cart-product">
                            <img src="@item.ImageUrl" alt="@item.ProductName" onerror="this.src='/images/placeholder.jpg'" />
                            <span>@item.ProductName</span>
                        </div>
                        <div class="cart-price">Rs. @item.Price.ToString("N0")</div>
                        <div class="cart-qty">
                            <form asp-controller="Cart" asp-action="Update" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <div class="qty-control-small">
                                    <button type="button" onclick="updateCartQty(@item.ProductId, @(item.Quantity - 1))">-</button>
                                    <input type="number" name="qty" value="@item.Quantity" min="1" id="qty_@item.ProductId" />
                                    <button type="button" onclick="updateCartQty(@item.ProductId, @(item.Quantity + 1))">+</button>
                                </div>
                            </form>
                        </div>
                        <div class="cart-total">Rs. @item.Total.ToString("N0")</div>
                        <div class="cart-remove">
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="remove-btn"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="cart-summary">
                <div class="summary-card">
                    <h3>Order Summary</h3>
                    <div class="summary-row">
                        <span>Subtotal (@Model.Count items)</span>
                        <span>Rs. @ViewBag.Total?.ToString("N0")</span>
                    </div>
                    <div class="summary-row">
                        <span>Delivery</span>
                        <span>@(ViewBag.Total >= 5000 ? "Free" : "Rs. 200")</span>
                    </div>
                    <div class="summary-total">
                        <span>Total</span>
                        <span>Rs. @(((decimal)ViewBag.Total + (ViewBag.Total >= 5000 ? 0 : 200)).ToString("N0"))</span>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Checkout" class="btn-checkout">
                            <i class="fas fa-lock"></i> Proceed to Checkout
                        </a>
                    }
                    else
                    {
                        <a href="/Account/Login?returnUrl=/Checkout" class="btn-checkout">
                            <i class="fas fa-sign-in-alt"></i> Login to Checkout
                        </a>
                        <p class="login-note"><i class="fas fa-info-circle"></i> Login is required before checkout</p>
                    }
                    <a href="/Home/Products" class="btn-continue">
                        <i class="fas fa-arrow-left"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
function updateCartQty(productId, newQty) {
    if (newQty < 1) return;
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/Cart/Update';
    var token = document.querySelector('input[name="__RequestVerificationToken"]');
    if (token) {
        var t = document.createElement('input');
        t.type = 'hidden'; t.name = '__RequestVerificationToken'; t.value = token.value;
        form.appendChild(t);
    }
    var pid = document.createElement('input');
    pid.type = 'hidden'; pid.name = 'productId'; pid.value = productId;
    form.appendChild(pid);
    var qty = document.createElement('input');
    qty.type = 'hidden'; qty.name = 'qty'; qty.value = newQty;
    form.appendChild(qty);
    document.body.appendChild(form);
    form.submit();
}
</script>
}
