@{
    ViewData["Title"] = "About Us";
}
<div class="page-header">
    <div class="container">
        <h1>About Us</h1>
        <p>The story of Winter Shelton House</p>
    </div>
</div>
<div class="container" style="max-width:800px;margin:40px auto 80px;text-align:center">
    <i class="fas fa-snowflake" style="font-size:64px;color:#0d1b2a;margin-bottom:20px;display:block"></i>
