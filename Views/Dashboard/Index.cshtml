@model List<WinterSheltonHouse.Models.Order>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <h1><i class="fas fa-tachometer-alt"></i> Dashboard</h1>
    <p>Winter Shelton House - Admin Panel</p>
</div>

<!-- Stats Cards -->
<div class="stats-grid">
    <div class="stat-card blue">
        <div class="stat-icon"><i class="fas fa-box"></i></div>
        <div class="stat-info">
            <h3>@ViewBag.TotalProducts</h3>
            <p>Total Products</p>
        </div>
    </div>
    <div class="stat-card green">
        <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
        <div class="stat-info">
            <h3>@ViewBag.TotalOrders</h3>
            <p>Total Orders</p>
        </div>
    </div>
    <div class="stat-card orange">
        <div class="stat-icon"><i class="fas fa-rupee-sign"></i></div>
        <div class="stat-info">
            <h3>Rs. @(((decimal)ViewBag.TotalRevenue).ToString("N0"))</h3>
            <p>Total Revenue</p>
        </div>
    </div>
    <div class="stat-card purple">
        <div class="stat-icon"><i class="fas fa-users"></i></div>
        <div class="stat-info">
            <h3>@ViewBag.TotalCustomers</h3>
            <p>Customers</p>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="quick-actions">
    <a href="/Admin/Dashboard/CreateProduct" class="quick-btn">
        <i class="fas fa-plus"></i> New Product
    </a>
    <a href="/Admin/Dashboard/Products" class="quick-btn">
        <i class="fas fa-boxes"></i> All Products
    </a>
    <a href="/Admin/Dashboard/Orders" class="quick-btn">
        <i class="fas fa-clipboard-list"></i> All Orders
    </a>
    <a href="/Admin/Dashboard/Customers" class="quick-btn">
        <i class="fas fa-users"></i> Customers
    </a>
</div>

<!-- Recent Orders -->
<div class="admin-section">
    <div class="section-header">
        <h2>Recent Orders</h2>
        <a href="/Admin/Dashboard/Orders" class="view-all">View All</a>
    </div>
    <div class="table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>@order.User?.FullName</td>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>Rs. @order.TotalAmount.ToString("N0")</td>
                        <td>
                            @if (order.PaymentMethod == WinterSheltonHouse.Models.PaymentMethod.CashOnDelivery)
                            {
                                <span class="badge-sm cod-sm">COD</span>
                            }
                            else
                            {
                                <span class="badge-sm card-sm">Card</span>
                            }
                        </td>
                        <td><span class="status-badge status-@order.Status.ToString().ToLower()">@order.Status</span></td>
                        <td><a href="/Admin/Dashboard/OrderDetail/@order.Id" class="action-link">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
