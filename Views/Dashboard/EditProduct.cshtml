@model WinterSheltonHouse.Models.ProductEditViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "New Product" : "Edit Product";
    Layout = "_AdminLayout";
    bool isEdit = Model.Id != 0;
}

<div class="admin-section-header">
    <h2>@(isEdit ? "Edit Product" : "New Product")</h2>
    <a href="/Admin/Dashboard/Products" class="btn-back-admin">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

<div class="form-card">
    <form asp-action="@(isEdit ? "EditProduct" : "CreateProduct")" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-error"></div>
        <input asp-for="Id" type="hidden" />

        <div class="form-grid">
            <div class="form-group full-width">
                <label>Product Name *</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Woolen Winter Sweater" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="form-group">
                <label>Category *</label>
                <select asp-for="Category" class="form-control"
                        asp-items="Html.GetEnumSelectList<WinterSheltonHouse.Models.ProductCategory>()"></select>
                <span asp-validation-for="Category" class="field-error"></span>
            </div>

            <div class="form-group">
                <label>Price (Rs.) *</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="2500" />
                <span asp-validation-for="Price" class="field-error"></span>
            </div>

            <div class="form-group">
                <label>Stock</label>
                <input asp-for="Stock" class="form-control" type="number" placeholder="50" />
            </div>

            <div class="form-group">
                <label>Image URL</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="/images/product.jpg" />
            </div>

            <div class="form-group full-width">
                <label>Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Product ki description here..."></textarea>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Active (visible on website)</span>
                </label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-admin-primary">
                <i class="fas fa-save"></i> @(isEdit ? "Update" : "Save")
            </button>
            <a href="/Admin/Dashboard/Products" class="btn-admin-cancel">Cancel</a>
        </div>
    </form>
</div>
